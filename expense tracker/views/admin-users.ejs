<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin | Users</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/admin/dashboard">Admin Panel</a>
    <div>
      <a href="/admin/logout" class="btn btn-outline-light">Logout</a>
    </div>
  </div>
</nav>

<section class="container py-5">
  <h2 class="mb-4">Registered Users</h2>
  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle bg-white">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th class="text-end">Joined</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="3" class="text-center py-4">No users registered yet.</td></tr>
        <% } else { %>
          <% users.forEach((user) => { %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td class="text-end"><%= user.createdAt.toDateString() %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

</body>
</html>
