<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin | Expense List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/admin/dashboard">Admin Panel</a>
    <div>
      <a href="/admin/logout" class="btn btn-outline-light">Logout</a>
    </div>
  </div>
</nav>

<section class="container py-5">
  <h2 class="mb-4">All User Expenses</h2>
  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle bg-white">
      <thead class="table-dark">
        <tr>
          <th>Date</th>
          <th>User</th>
          <th>Item</th>
          <th>Category</th>
          <th class="text-end">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% if (expenses.length === 0) { %>
          <tr><td colspan="5" class="text-center py-4">No expenses found.</td></tr>
        <% } else { %>
          <% expenses.forEach((expense) => { %>
            <tr>
              <td><%= expense.date.toDateString() %></td>
              <td><%= expense.user ? expense.user.name : "Unknown" %> (<%= expense.user ? expense.user.email : "-" %>)</td>
              <td><%= expense.title %></td>
              <td><%= expense.category %></td>
              <td class="text-end">₹<%= expense.amount.toFixed(2) %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

</body>
</html>
