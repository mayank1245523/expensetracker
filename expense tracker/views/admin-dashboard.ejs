<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard | Expense Tracker</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-panel">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/admin/dashboard">Admin Panel</a>
    <div>
      <a href="/admin/logout" class="btn btn-outline-light">Logout</a>
    </div>
  </div>
</nav>

<section class="container py-5">
  <div class="admin-hero">
    <div class="hero-content">
      <h2 class="mb-3">Welcome, Admin</h2>
      <p class="lead">Manage users, review expenses, and keep the platform running smoothly with a polished admin experience.</p>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card admin-card shadow-sm p-4 text-center">
        <h5>View All Expenses</h5>
        <p class="text-muted">Browse every user expense with ease.</p>
        <a href="/admin/expenses" class="btn btn-primary mt-3">Go</a>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card admin-card shadow-sm p-4 text-center">
        <h5>Manage Users</h5>
        <p class="text-muted">Review registered accounts and control access.</p>
        <a href="/admin/users" class="btn btn-primary mt-3">Go</a>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card admin-card shadow-sm p-4 text-center">
        <h5>System Settings</h5>
        <p class="text-muted">Configure app defaults and admin options.</p>
        <a href="/admin/settings" class="btn btn-primary mt-3">Go</a>
      </div>
    </div>
  </div>
</section>

<footer class="footer-compact text-center py-4">
  <p class="mb-0 text-muted">© 2026 ExpenseTracker Admin Panel</p>
</footer>

</body>
</html>
