<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Expense | Expense Tracker</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-shell">

<div class="auth-panel">
  <div class="panel-image" style="background-image: linear-gradient(180deg, rgba(79,70,229,0.88), rgba(14,165,233,0.78)), url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=80');">
    <div class="p-4 text-white" style="position:absolute; bottom:0; left:0; right:0;">
      <h4 class="mb-2">Add expenses quickly</h4>
      <p class="small opacity-75">Enter spendings with category, amount, and date to power your dashboard analytics.</p>
    </div>
  </div>
  <div class="auth-form card p-4 shadow-sm">
    <div class="d-flex align-items-start justify-content-between mb-4">
      <div>
        <h3 class="mb-2">Add New Expense</h3>
        <p class="text-muted">Keep your budget up to date with smart logging.</p>
      </div>
      <a href="/dashboard" class="btn btn-outline-secondary">Back</a>
    </div>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form action="/add-expense" method="POST">
      <div class="mb-3">
        <label for="title" class="form-label">Item / Expense</label>
        <div class="input-group">
          <input type="text" name="title" id="title" class="form-control" placeholder="e.g. Groceries" required>
          <button type="button" id="suggestCategory" class="btn btn-outline-secondary">AI Suggest</button>
        </div>
      </div>
      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <input type="text" name="category" id="category" class="form-control" placeholder="e.g. Food, Transport" required>
        <div id="categorySuggestion" class="form-text text-muted" style="display: none;">AI suggested: <span id="suggestedCategory"></span></div>
      </div>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label for="amount" class="form-label">Amount</label>
          <input type="number" step="0.01" min="0" name="amount" id="amount" class="form-control" placeholder="₹0.00" required>
        </div>
        <div class="col-md-6">
          <label for="date" class="form-label">Date</label>
          <input type="date" name="date" id="date" class="form-control" required value="<%= new Date().toISOString().split('T')[0] %>">
        </div>
      </div>
      <button type="submit" class="btn btn-primary w-100">Save Expense</button>
    </form>
  </div>
</div>

<script>
document.getElementById('suggestCategory').addEventListener('click', async () => {
  const title = document.getElementById('title').value.trim();
  if (!title) {
    alert('Please enter an expense title first.');
    return;
  }

  try {
    const response = await fetch('/ai/categorize', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ title }),
    });
    const data = await response.json();
    document.getElementById('suggestedCategory').textContent = data.category;
    document.getElementById('categorySuggestion').style.display = 'block';
    document.getElementById('category').value = data.category;
  } catch (error) {
    console.error('Error suggesting category:', error);
    alert('Unable to get AI suggestion. Please try again.');
  }
});
</script>

</body>
</html>
